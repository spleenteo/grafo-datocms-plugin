{
  "name": "datocms-plugin-grafo",
  "version": "1.1.0",
  "description": "Record relations of a DatoCMS project as an interactive graph, filtered by model, status and relation field, with role-aware loading.",
  "type": "module",
  "keywords": [
    "datocms-plugin",
    "datocms",
    "graph",
    "relations",
    "d3",
    "visualization"
  ],
  "homepage": "https://github.com/spleenteo/grafo-datocms-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spleenteo/grafo-datocms-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/spleenteo/grafo-datocms-plugin/issues"
  },
  "author": "spleenteo",
  "license": "MIT",
  "datoCmsPlugin": {
    "title": "Grafo",
    "previewImage": "assets/preview.mp4",
    "coverImage": "assets/cover.png",
    "entryPoint": "dist/index.html",
    "permissions": [
      "currentUserAccessToken"
    ]
  },
  "files": [
    "dist",
    "assets/cover.png",
    "assets/preview.mp4"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@datocms/cma-client-browser": "^6.1.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "datocms-plugin-sdk": "^2.5.0",
    "datocms-react-ui": "^2.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "datocms-react-ui": {
      "react-intersection-observer": "^10.0.3",
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
